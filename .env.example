# ABA PayWay credentials — request sandbox credentials from ABA.
# Do not commit real credentials to source control.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_SECRET_KEY=
PAYWAY_ENV=sandbox

# Email confirmation (example SMTP settings; use your provider's values)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=KhmerGlobe <your-business-email@example.com>
